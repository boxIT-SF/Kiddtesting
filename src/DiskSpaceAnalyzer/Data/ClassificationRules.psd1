<#
    ClassificationRules.psd1

    Ordered rule set used to answer three questions about every file found on disk:

        1. What is this data?            -> Name / Category / Description
        2. Is it safe to delete?         -> Safety  (Safe | Review | Unsafe)
        3. If not, what can be done?     -> Remediation / Command

    Matching semantics (see Resolve-DsaFileCategory):

        Priority          Lower numbers are evaluated first. First match wins.
        PathPattern       Case-insensitive regex tested against the *directory* of the file,
                          using backslash separators and a trailing backslash.
        NamePattern       Case-insensitive regex tested against the file name.
        Extensions        Lower-case extensions including the dot. Any match qualifies.
        EligibleAfterDays A file only becomes a reclamation *candidate* once it is at least
                          this many days old (by LastWriteTime). It is still classified and
                          reported before then, it just does not count toward the plan.

    Safety levels:

        Safe    Removable by an automated job with no owner sign-off. Regenerated by the OS
                or the application, or already a copy of something else.
        Review  Almost certainly reclaimable, but the size, the owner, or the retention
                requirement has to be confirmed by a person first.
        Unsafe  Never delete these files directly. The Remediation field describes the
                supported way to shrink or relocate the data instead.
#>
@{
    SchemaVersion = 2
    Rules = @(

        #region Windows servicing and OS caches -------------------------------------------------
        @{
            Id = 'win-update-cache'
            Name = 'Windows Update download cache'
            Category = 'Windows servicing'
            Safety = 'Safe'
            Priority = 10
            PathPattern = '\\Windows\\SoftwareDistribution\\Download\\'
            Description = 'Installer payloads Windows Update already applied (or abandoned). Windows re-downloads anything it still needs.'
            Reason = 'Purely a cache. Clearing it is the documented fix for a bloated SoftwareDistribution folder.'
            Remediation = ''
            Command = 'Stop-Service wuauserv,bits; Remove-Item "$env:SystemRoot\SoftwareDistribution\Download\*" -Recurse -Force; Start-Service wuauserv,bits'
            Method = 'Delete'
        }
        @{
            Id = 'win-delivery-optimization'
            Name = 'Delivery Optimization peer cache'
            Category = 'Windows servicing'
            Safety = 'Safe'
            Priority = 11
            PathPattern = '\\(SoftwareDistribution\\DeliveryOptimization|ProgramData\\Microsoft\\Network\\Downloader)\\'
            Description = 'Update content held so other machines on the LAN can pull it peer-to-peer.'
            Reason = 'Cache only. Delivery Optimization rebuilds it on the next update cycle.'
            Remediation = ''
            Command = 'Delete-DeliveryOptimizationCache -Force'
            Method = 'Delete'
        }
        @{
            Id = 'win-old'
            Name = 'Previous Windows installation (Windows.old)'
            Category = 'Windows servicing'
            Safety = 'Safe'
            Priority = 12
            PathPattern = '^[A-Za-z]:\\(\$WINDOWS\.~BT|\$WINDOWS\.~WS|Windows\.old)\\'
            EligibleAfterDays = 10
            Description = 'The pre-upgrade copy of Windows kept so the feature update can be rolled back.'
            Reason = 'Only needed for the 10-day rollback window. After that Windows deletes it itself - often the single largest easy win on an upgraded machine.'
            Remediation = 'Roll back first if the upgrade is still being validated.'
            Command = 'cleanmgr /sagerun:1   # or: Remove-Item C:\Windows.old -Recurse -Force'
            Method = 'Tool'
        }
        @{
            Id = 'win-winsxs'
            Name = 'Component store (WinSxS)'
            Category = 'Windows servicing'
            Safety = 'Unsafe'
            Priority = 13
            PathPattern = '\\Windows\\WinSxS\\'
            Description = 'Every OS component and superseded update payload. Most of it is hard links, so the reported size is much larger than the space it actually occupies.'
            Reason = 'Deleting anything here corrupts servicing and can make the machine unbootable or unpatchable.'
            Remediation = 'Shrink it with the supported servicing command instead. ResetBase removes the ability to uninstall existing updates, so only run it once the current patch level is known good.'
            Command = 'Dism.exe /Online /Cleanup-Image /AnalyzeComponentStore; Dism.exe /Online /Cleanup-Image /StartComponentCleanup /ResetBase'
            Method = 'Tool'
        }
        @{
            Id = 'win-installer'
            Name = 'Windows Installer cache'
            Category = 'Windows servicing'
            Safety = 'Unsafe'
            Priority = 14
            PathPattern = '\\Windows\\Installer\\'
            Description = 'Cached .msi/.msp packages used to repair, patch and uninstall installed software.'
            Reason = 'Deleting these breaks repair and uninstall for the affected products, and future patches for them will fail.'
            Remediation = 'Only orphaned patches may be removed, and only with a tool that verifies the reference first (PatchCleaner, or msizap on legacy builds). Never bulk-delete the folder.'
            Command = ''
            Method = 'Tool'
        }
        @{
            Id = 'win-driverstore'
            Name = 'Driver store (DriverStore\FileRepository)'
            Category = 'Windows servicing'
            Safety = 'Unsafe'
            Priority = 15
            PathPattern = '\\Windows\\System32\\DriverStore\\'
            Description = 'Staged copies of every driver package installed on the machine, including superseded versions.'
            Reason = 'Direct deletion breaks device installation and rollback.'
            Remediation = 'Enumerate and remove only superseded OEM driver packages with pnputil.'
            Command = 'pnputil /enum-drivers   # then: pnputil /delete-driver oemNN.inf /uninstall'
            Method = 'Tool'
        }
        @{
            Id = 'win-panther'
            Name = 'Setup and upgrade logs'
            Category = 'Windows logs'
            Safety = 'Safe'
            Priority = 16
            PathPattern = '\\Windows\\(Panther|inf)\\'
            EligibleAfterDays = 30
            Description = 'Logs written by Windows Setup, feature updates and driver installation.'
            Reason = 'Diagnostic output only. Nothing reads them once the upgrade succeeded.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'win-logs'
            Name = 'Windows servicing logs (CBS/DISM)'
            Category = 'Windows logs'
            Safety = 'Safe'
            Priority = 17
            PathPattern = '\\Windows\\Logs\\'
            EligibleAfterDays = 30
            Description = 'CBS, DISM and maintenance logs. On a machine with a failing update these grow without limit.'
            Reason = 'Rolled over and rewritten by the OS. Keep the newest for troubleshooting, delete the archived ones.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'win-livekernel'
            Name = 'Live kernel reports'
            Category = 'Crash data'
            Safety = 'Safe'
            Priority = 18
            PathPattern = '\\Windows\\LiveKernelReports\\'
            EligibleAfterDays = 14
            Description = 'Kernel dumps captured after a non-fatal hardware or driver stall.'
            Reason = 'Only useful to a driver vendor while the incident is being investigated.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'win-prefetch'
            Name = 'Prefetch data'
            Category = 'Windows caches'
            Safety = 'Review'
            Priority = 19
            PathPattern = '\\Windows\\Prefetch\\'
            Description = 'Application launch traces used to speed up start-up.'
            Reason = 'Safe to delete technically, but it is small, it slows the next few launches, and it is frequently used as forensic evidence.'
            Remediation = 'Leave it alone unless a forensic hold does not apply and the folder is unusually large.'
            Command = ''
            Method = 'Delete'
        }
        #endregion

        #region Paging, hibernation, crash dumps ------------------------------------------------
        @{
            Id = 'sys-pagefile'
            Name = 'Page file / swap file'
            Category = 'System reserved'
            Safety = 'Unsafe'
            Priority = 20
            NamePattern = '^(pagefile|swapfile)\.sys$'
            Description = 'Virtual memory backing store. Sized by Windows relative to installed RAM.'
            Reason = 'Cannot be deleted while running, and removing it destabilises the machine and disables kernel crash dumps.'
            Remediation = 'If the volume is tight, cap the page file at a fixed size or move it to another volume, then reboot. Keep at least enough for the configured dump type.'
            Command = 'SystemPropertiesAdvanced.exe   # Performance > Advanced > Virtual memory'
            Method = 'Policy'
            RequiresReboot = $true
        }
        @{
            Id = 'sys-hiberfil'
            Name = 'Hibernation file (hiberfil.sys)'
            Category = 'System reserved'
            Safety = 'Review'
            Priority = 21
            NamePattern = '^hiberfil\.sys$'
            Description = 'RAM image reserved for hibernate and Fast Startup. Typically 40 percent of installed RAM.'
            Reason = 'Reclaimable in full, but disabling hibernation removes Fast Startup and the ability to hibernate - normally acceptable on a desktop or server, rarely on a laptop.'
            Remediation = 'On a server or always-on desktop disable it outright. On a laptop shrink it instead of removing it.'
            Command = 'powercfg /hibernate off        # or keep hibernate: powercfg /hibernate /size 40'
            Method = 'Policy'
        }
        @{
            Id = 'sys-memorydump'
            Name = 'Kernel crash dump'
            Category = 'Crash data'
            Safety = 'Safe'
            Priority = 22
            NamePattern = '^(MEMORY\.DMP|LiveKernelReport.*\.dmp)$'
            Description = 'Full memory dump written after a bugcheck. Its size tracks installed RAM.'
            Reason = 'Only needed while the bugcheck is being analysed. Windows overwrites it on the next crash.'
            Remediation = 'Analyse or archive it first if the machine is bluescreening.'
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'sys-minidump'
            Name = 'Minidumps'
            Category = 'Crash data'
            Safety = 'Safe'
            Priority = 23
            PathPattern = '\\Windows\\Minidump\\'
            EligibleAfterDays = 30
            Description = 'Small per-bugcheck dumps.'
            Reason = 'Historical crash records only.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'sys-wer'
            Name = 'Windows Error Reporting queue'
            Category = 'Crash data'
            Safety = 'Safe'
            Priority = 24
            PathPattern = '\\(ProgramData|Users\\[^\\]+\\AppData\\Local)\\Microsoft\\Windows\\WER\\'
            Description = 'User-mode crash reports queued for (or already sent to) Microsoft.'
            Reason = 'Reporting queue only. A repeatedly crashing service can fill a volume with these.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        #endregion

        #region Shadow copies, recycle bin, search ----------------------------------------------
        @{
            Id = 'sys-vss'
            Name = 'Volume Shadow Copies / System Restore'
            Category = 'Shadow copies'
            Safety = 'Unsafe'
            Priority = 30
            PathPattern = '\\System Volume Information\\'
            Description = 'Shadow copy storage backing System Restore, Previous Versions and image backups.'
            Reason = 'The files are not directly deletable and removing them destroys every restore point and Previous Versions history on the volume.'
            Remediation = 'Cap the shadow storage allocation, or delete the oldest shadow copies through VSS. Confirm with the backup owner first - some backup products depend on these.'
            Command = 'vssadmin list shadowstorage; vssadmin resize shadowstorage /for=C: /on=C: /maxsize=25GB'
            Method = 'Tool'
        }
        @{
            Id = 'sys-recyclebin'
            Name = 'Recycle Bin'
            Category = 'Recycle Bin'
            Safety = 'Safe'
            Priority = 31
            PathPattern = '\\\$Recycle\.Bin\\'
            Description = 'Files users already deleted, held pending a restore.'
            Reason = 'The user already chose to delete this. Only an undelete would need it.'
            Remediation = 'Confirm no one is mid-recovery, then empty per user.'
            Command = 'Clear-RecycleBin -Force'
            Method = 'Delete'
        }
        @{
            Id = 'sys-searchindex'
            Name = 'Windows Search index'
            Category = 'Windows caches'
            Safety = 'Review'
            Priority = 32
            NamePattern = '^Windows\.edb$'
            Description = 'The content index behind Start menu and Outlook search.'
            Reason = 'Fully rebuildable, but rebuilding is I/O heavy and search is degraded until it finishes.'
            Remediation = 'Rebuild the index out of hours, or narrow the indexed locations so it stops growing.'
            Command = 'Stop-Service WSearch; Remove-Item "$env:ProgramData\Microsoft\Search\Data\Applications\Windows\Windows.edb" -Force; Start-Service WSearch'
            Method = 'Tool'
        }
        @{
            Id = 'sys-spool'
            Name = 'Print spooler queue'
            Category = 'Windows caches'
            Safety = 'Safe'
            Priority = 33
            PathPattern = '\\System32\\spool\\PRINTERS\\'
            EligibleAfterDays = 3
            Description = 'Spooled print jobs, including jobs stuck against an offline printer.'
            Reason = 'Anything older than a few days is an abandoned job.'
            Remediation = ''
            Command = 'Stop-Service Spooler; Remove-Item "$env:SystemRoot\System32\spool\PRINTERS\*" -Force; Start-Service Spooler'
            Method = 'Delete'
        }
        @{
            Id = 'sys-defender-scans'
            Name = 'Defender scan history'
            Category = 'Security tooling'
            Safety = 'Safe'
            Priority = 34
            PathPattern = '\\Microsoft\\Windows Defender\\Scans\\History\\'
            EligibleAfterDays = 30
            Description = 'Historical scan results and detection metadata.'
            Reason = 'Regenerated on each scan. Detections are already reported to the security console.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'sys-quarantine'
            Name = 'Antivirus quarantine'
            Category = 'Security tooling'
            Safety = 'Unsafe'
            Priority = 35
            PathPattern = '\\(Quarantine|QuarantineStore)\\'
            Description = 'Detected malware held in an encrypted store.'
            Reason = 'Deleting outside the product can leave the console in an inconsistent state, and destroys evidence for an open incident.'
            Remediation = 'Purge from the security console, or shorten the quarantine retention policy.'
            Command = ''
            Method = 'Policy'
        }
        #endregion

        #region Temp directories ----------------------------------------------------------------
        @{
            Id = 'temp-windows'
            Name = 'Windows temp directory'
            Category = 'Temp files'
            Safety = 'Safe'
            Priority = 40
            PathPattern = '\\Windows\\Temp\\'
            EligibleAfterDays = 7
            Description = 'Scratch space used by services, installers and scheduled tasks running as SYSTEM.'
            Reason = 'Anything older than a few days was orphaned by a process that has already exited.'
            Remediation = ''
            Command = 'Get-ChildItem "$env:SystemRoot\Temp" -Recurse -Force -File | Where-Object LastWriteTime -lt (Get-Date).AddDays(-7) | Remove-Item -Force'
            Method = 'Delete'
        }
        @{
            Id = 'temp-user'
            Name = 'User temp directory'
            Category = 'Temp files'
            Safety = 'Safe'
            Priority = 41
            PathPattern = '\\Users\\[^\\]+\\AppData\\Local\\Temp\\'
            EligibleAfterDays = 7
            Description = 'Per-user scratch space. Office, browsers and installers leave large files behind here.'
            Reason = 'Orphaned once the owning process exits. Files still in use are locked and will be skipped.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'temp-office-lock'
            Name = 'Orphaned Office lock/owner files'
            Category = 'Temp files'
            Safety = 'Safe'
            Priority = 42
            NamePattern = '^~\$'
            EligibleAfterDays = 7
            Description = 'Hidden owner files Office leaves behind when a document is not closed cleanly.'
            Reason = 'Meaningless once the document is closed. They also cause false "file in use" prompts.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'temp-extensions'
            Name = 'Temporary and superseded working files'
            Category = 'Temp files'
            Safety = 'Safe'
            Priority = 43
            Extensions = @('.tmp', '.temp', '.partial', '.crdownload', '.download', '.~tmp', '._mp')
            EligibleAfterDays = 30
            Description = 'Interrupted downloads and abandoned scratch files.'
            Reason = 'By definition disposable, and a month past its last write it belongs to nothing.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'temp-backup-copies'
            Name = 'Ad-hoc .bak/.old copies'
            Category = 'Temp files'
            Safety = 'Review'
            Priority = 44
            Extensions = @('.old', '.orig', '.prev', '.copy')
            EligibleAfterDays = 180
            Description = 'Manual "just in case" copies made before an edit or an upgrade.'
            Reason = 'Usually dead weight, but occasionally the only copy of a config someone still depends on.'
            Remediation = 'Confirm the live file is healthy, then delete the copy.'
            Command = ''
            Method = 'Delete'
        }
        #endregion

        #region Browser and application caches --------------------------------------------------
        @{
            Id = 'cache-chromium'
            Name = 'Chromium browser cache'
            Category = 'Browser caches'
            Safety = 'Safe'
            Priority = 50
            PathPattern = '\\User Data\\.*\\(Cache|Code Cache|GPUCache|Service Worker\\CacheStorage|Media Cache)'
            Description = 'Chrome, Edge or Brave content cache. Not bookmarks, passwords or profiles.'
            Reason = 'Rebuilt on demand. Only cost is slightly slower first page loads.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'cache-firefox'
            Name = 'Firefox cache'
            Category = 'Browser caches'
            Safety = 'Safe'
            Priority = 51
            PathPattern = '\\AppData\\Local\\Mozilla\\Firefox\\Profiles\\'
            Description = 'Firefox content and startup cache (the roaming profile holds the real user data).'
            Reason = 'Rebuilt on demand.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'cache-collab-apps'
            Name = 'Collaboration app cache'
            Category = 'Application caches'
            Safety = 'Safe'
            Priority = 52
            PathPattern = '\\AppData\\(Roaming|Local)\\(Microsoft\\Teams|Packages\\MSTeams_[^\\]+|Slack|Zoom|discord|Postman|Spotify)\\'
            Description = 'Teams, Slack, Zoom, Discord and similar Electron app caches, including downloaded avatars and message media.'
            Reason = 'Re-fetched from the service on next sign-in. Close the app first so the files are not locked.'
            Remediation = ''
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'cache-office'
            Name = 'Office document cache'
            Category = 'Application caches'
            Safety = 'Review'
            Priority = 53
            PathPattern = '\\AppData\\Local\\Microsoft\\Office\\[^\\]+\\OfficeFileCache\\'
            Description = 'Local copies of documents opened from SharePoint or OneDrive, plus pending uploads.'
            Reason = 'Normally disposable, but a file with unsynced edits lives here too - clearing it during a sync error loses those edits.'
            Remediation = 'Confirm the Upload Center / OneDrive sync is clean, then clear the cache from Office settings.'
            Command = ''
            Method = 'Tool'
        }
        @{
            Id = 'cache-dev-packages'
            Name = 'Developer package cache'
            Category = 'Application caches'
            Safety = 'Safe'
            Priority = 54
            PathPattern = '\\(\.nuget\\packages|\.m2\\repository|\.gradle\\caches|AppData\\Local\\(npm-cache|Yarn|pip\\Cache|NuGet)|AppData\\Roaming\\npm-cache)\\'
            EligibleAfterDays = 60
            Description = 'Downloaded NuGet, npm, pip, Maven or Gradle packages.'
            Reason = 'Restorable from the package feed. Only cost is a slower first build.'
            Remediation = ''
            Command = 'dotnet nuget locals all --clear; npm cache clean --force'
            Method = 'Delete'
        }
        @{
            Id = 'cache-node-modules'
            Name = 'node_modules / build output'
            Category = 'Application caches'
            Safety = 'Review'
            Priority = 55
            PathPattern = '\\(node_modules|\\bin\\(Debug|Release)|\\obj\\(Debug|Release)|target\\classes)\\'
            EligibleAfterDays = 90
            Description = 'Restorable dependency trees and compiler output inside source checkouts.'
            Reason = 'Rebuildable from source, but only if the checkout still has a working lockfile and feed access.'
            Remediation = 'Confirm the repository is pushed, then delete and let the next build restore it.'
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'cache-container'
            Name = 'WSL / Docker virtual disk'
            Category = 'Virtualisation'
            Safety = 'Review'
            Priority = 56
            PathPattern = '\\AppData\\Local\\(Docker|Packages\\[^\\]+\\LocalState)\\'
            Extensions = @('.vhdx', '.vhd')
            Description = 'WSL distribution or Docker Desktop data disk. These grow and never shrink on their own.'
            Reason = 'It holds live container and distro data, so it must be compacted rather than deleted.'
            Remediation = 'Prune unused images/volumes, then compact the virtual disk.'
            Command = 'docker system prune -a --volumes; wsl --shutdown; Optimize-VHD -Path <path> -Mode Full'
            Method = 'Tool'
        }
        @{
            Id = 'cache-generic'
            Name = 'Generic application cache folder'
            Category = 'Application caches'
            Safety = 'Safe'
            Priority = 57
            PathPattern = '\\(Cache|Caches|CachedData|CacheStorage|GPUCache|Code Cache|Thumbnails|INetCache|WebCache)\\'
            EligibleAfterDays = 30
            Description = 'A folder the application itself labels as a cache.'
            Reason = 'Applications are expected to regenerate anything under a cache folder.'
            Remediation = 'Close the owning application first so files are not locked.'
            Command = ''
            Method = 'Delete'
        }
        #endregion

        #region Mail and sync -------------------------------------------------------------------
        @{
            Id = 'mail-ost'
            Name = 'Outlook offline cache (.ost)'
            Category = 'Mail data'
            Safety = 'Review'
            Priority = 60
            Extensions = @('.ost', '.nst')
            Description = 'Local cached copy of a mailbox. The authoritative data is in Exchange or Microsoft 365.'
            Reason = 'Rebuildable from the server, but rebuilding re-downloads the whole mailbox - painful on a slow link, and any locally-created-only items would be lost.'
            Remediation = 'Reduce the cached mail slider (e.g. 3 or 6 months) rather than deleting the file. Shared mailboxes downloaded to the OST are the usual cause of a huge .ost.'
            Command = 'Outlook > File > Account Settings > Change > Mail to keep offline'
            Method = 'Policy'
        }
        @{
            Id = 'mail-pst'
            Name = 'Outlook personal folders (.pst)'
            Category = 'Mail data'
            Safety = 'Unsafe'
            Priority = 61
            Extensions = @('.pst')
            Description = 'A user-owned mail archive. Frequently the only copy of years of mail, and rarely backed up.'
            Reason = 'Not a cache. Deleting it destroys mail that exists nowhere else.'
            Remediation = 'Import into the mailbox or an online archive, or move the file to a backed-up file share and repoint Outlook at it.'
            Command = ''
            Method = 'Policy'
        }
        @{
            Id = 'sync-onedrive'
            Name = 'OneDrive / SharePoint synced content'
            Category = 'Cloud sync'
            Safety = 'Review'
            Priority = 62
            PathPattern = '\\Users\\[^\\]+\\(OneDrive|OneDrive - [^\\]+|[^\\]+ - [^\\]+)\\'
            Description = 'Files synced from OneDrive or a SharePoint library and materialised locally.'
            Reason = 'The cloud copy is authoritative, so local space can be released without data loss - but only through Files On-Demand, never by deleting, which would delete it from the cloud too.'
            Remediation = 'Turn on Files On-Demand and free up space on the largest folders. This is usually the biggest low-risk win on a user workstation.'
            Command = 'Right-click folder > Free up space   # or set the "Files On-Demand" policy via Intune/GPO'
            Method = 'Policy'
        }
        #endregion

        #region Server workloads ----------------------------------------------------------------
        @{
            Id = 'srv-iis-logs'
            Name = 'IIS request logs'
            Category = 'Server logs'
            Safety = 'Safe'
            Priority = 70
            PathPattern = '\\(inetpub\\logs|LogFiles\\W3SVC)'
            EligibleAfterDays = 90
            Description = 'W3C request logs, one file per site per day. They grow forever unless something trims them.'
            Reason = 'Beyond the retention period they have no operational value - but check whether a compliance policy requires keeping them.'
            Remediation = 'Confirm the retention requirement, then schedule a recurring trim instead of a one-off delete.'
            Command = 'Get-ChildItem C:\inetpub\logs\LogFiles -Recurse -File | Where-Object LastWriteTime -lt (Get-Date).AddDays(-90) | Remove-Item -Force'
            Method = 'Delete'
        }
        @{
            Id = 'srv-wsus'
            Name = 'WSUS update content'
            Category = 'Server workloads'
            Safety = 'Review'
            Priority = 71
            PathPattern = '\\WsusContent\\'
            Description = 'Update binaries downloaded for distribution to clients, including superseded and declined updates.'
            Reason = 'Reclaimable, but only through the WSUS cleanup wizard - deleting files directly leaves the database pointing at content that no longer exists.'
            Remediation = 'Decline superseded updates, then run the server cleanup wizard.'
            Command = 'Invoke-WsusServerCleanup -CleanupObsoleteUpdates -CleanupUnneededContentFiles -CompressUpdates'
            Method = 'Tool'
        }
        @{
            Id = 'srv-sql-backup'
            Name = 'SQL Server backup files'
            Category = 'Backups'
            Safety = 'Unsafe'
            Priority = 72
            Extensions = @('.bak', '.trn', '.dif')
            Description = 'Full, differential and transaction log backups. The transaction log chain depends on these being kept in order.'
            Reason = 'Breaking the chain destroys point-in-time recovery. The oldest full backup may also be the only copy that has been off-boxed.'
            Remediation = 'Verify the copies exist on the backup target, then enforce retention through the maintenance plan or Ola Hallengren cleanup - not by hand.'
            Command = 'EXEC master.dbo.xp_delete_file 0, N''D:\Backup'', N''bak'', ''<cutoff date>'';'
            Method = 'Policy'
        }
        @{
            Id = 'srv-sql-data'
            Name = 'SQL Server database files'
            Category = 'Databases'
            Safety = 'Unsafe'
            Priority = 73
            Extensions = @('.mdf', '.ndf', '.ldf')
            Description = 'Live database data and transaction log files. A huge .ldf almost always means FULL recovery with no log backups running.'
            Reason = 'These are the database. Deleting or moving them while the instance is online takes the database offline.'
            Remediation = 'For an oversized log: take a log backup (or switch to SIMPLE if point-in-time recovery is not required), then shrink the log file once and fix the backup job so it does not recur.'
            Command = 'BACKUP LOG [db] TO DISK=''...''; DBCC SHRINKFILE (N''db_log'', 4096);'
            Method = 'Policy'
        }
        @{
            Id = 'srv-exchange-db'
            Name = 'Exchange / Jet database'
            Category = 'Databases'
            Safety = 'Unsafe'
            Priority = 74
            Extensions = @('.edb', '.jrs', '.chk')
            Description = 'An ESE database and its checkpoint/reserve files (Exchange, AD, WSUS, Windows Search).'
            Reason = 'Live database state. Removing any part of it corrupts the store.'
            Remediation = 'Run a successful VSS-aware backup so committed transaction logs are truncated, which is what normally reclaims the space.'
            Command = ''
            Method = 'Policy'
        }
        @{
            Id = 'srv-hyperv'
            Name = 'Virtual machine disks and checkpoints'
            Category = 'Virtualisation'
            Safety = 'Unsafe'
            Priority = 75
            Extensions = @('.vhd', '.vhdx', '.avhd', '.avhdx', '.vmdk', '.vmrs', '.vsv', '.vmcx')
            Description = 'VM storage. An .avhdx is a differencing disk from a checkpoint - a long-lived one grows until it fills the volume.'
            Reason = 'Deleting a disk destroys the VM; deleting a differencing disk destroys every change made since the checkpoint.'
            Remediation = 'Delete stale checkpoints in the hypervisor so the differencing disks merge back, then compact dynamic disks offline. Storage-migrate anything still oversized.'
            Command = 'Get-VMSnapshot -VMName * | Where-Object CreationTime -lt (Get-Date).AddDays(-7); Optimize-VHD -Path <path> -Mode Full'
            Method = 'Tool'
        }
        @{
            Id = 'srv-backup-repo'
            Name = 'Backup repository data'
            Category = 'Backups'
            Safety = 'Unsafe'
            Priority = 76
            Extensions = @('.vbk', '.vib', '.vrb', '.vbm', '.bkf', '.tib', '.tibx', '.spf', '.spi')
            Description = 'Backup chains written by Veeam, Acronis, Unitrends or similar.'
            Reason = 'Deleting a file out of a backup chain invalidates every restore point that depends on it, usually silently until a restore is attempted.'
            Remediation = 'Shorten the retention policy in the backup product and let it prune, or move the repository to dedicated storage. Never delete from the file system.'
            Command = ''
            Method = 'Policy'
        }
        @{
            Id = 'srv-profile-disks'
            Name = 'FSLogix / UPD profile containers'
            Category = 'Virtualisation'
            Safety = 'Unsafe'
            Priority = 77
            PathPattern = '\\(FSLogix|UVHD|Profiles)\\'
            Extensions = @('.vhdx', '.vhd')
            Description = 'Per-user profile containers for RDS/AVD.'
            Reason = 'Each container is a live user profile including their Outlook cache.'
            Remediation = 'Compact the containers on a schedule, cap the OST size inside them, and remove containers belonging to deleted accounts.'
            Command = 'Invoke-FslShrinkDisk -Path <share> -DeleteOlderThanDays 90'
            Method = 'Tool'
        }
        #endregion

        #region Logs and event data -------------------------------------------------------------
        @{
            Id = 'log-eventlog'
            Name = 'Windows event logs'
            Category = 'Windows logs'
            Safety = 'Unsafe'
            Priority = 80
            PathPattern = '\\System32\\winevt\\Logs\\'
            Description = 'The live event log files, including the security log.'
            Reason = 'Deleting them breaks logging and destroys the audit trail that security tooling and incident response depend on.'
            Remediation = 'Export and clear through the supported tool, and cap each log size by policy so it stops growing.'
            Command = 'wevtutil epl Security C:\Archive\Security.evtx; wevtutil cl Security; wevtutil sl Security /ms:1073741824'
            Method = 'Tool'
        }
        @{
            Id = 'log-archived-evtx'
            Name = 'Archived event logs'
            Category = 'Windows logs'
            Safety = 'Review'
            Priority = 81
            Extensions = @('.evtx')
            EligibleAfterDays = 180
            Description = 'Rolled-over or manually exported event log archives.'
            Reason = 'Historic only, but often retained deliberately for compliance.'
            Remediation = 'Check the log retention requirement, then move to archive storage rather than deleting.'
            Command = ''
            Method = 'Policy'
        }
        @{
            Id = 'log-generic'
            Name = 'Application log and trace files'
            Category = 'Application logs'
            Safety = 'Review'
            Priority = 82
            Extensions = @('.log', '.log1', '.log2', '.etl', '.blg', '.trace', '.trc', '.dmp', '.err', '.out')
            EligibleAfterDays = 90
            Description = 'Diagnostic output from applications and agents. A runaway logger is a common cause of a suddenly full volume.'
            Reason = 'Almost always disposable past the retention window, but the owning application may need the current file, and some are evidence for an open ticket.'
            Remediation = 'Stop the writer if a single file is huge, fix its rotation settings, then trim on a schedule.'
            Command = ''
            Method = 'Delete'
        }
        #endregion

        #region User data -----------------------------------------------------------------------
        @{
            Id = 'user-downloads'
            Name = 'Downloads folder'
            Category = 'User data'
            Safety = 'Review'
            Priority = 90
            PathPattern = '\\Users\\[^\\]+\\Downloads\\'
            EligibleAfterDays = 180
            Description = 'Installers, ISOs, exports and attachments a user pulled down and never cleaned up.'
            Reason = 'Nearly always re-downloadable, and untouched for months - but it is the user''s data, so it needs their nod or a published policy.'
            Remediation = 'Notify the users, give them a grace period, then apply a Storage Sense or scheduled-cleanup policy so it does not build up again.'
            Command = 'Storage Sense: delete files in Downloads unopened for 60 days (Intune/GPO)'
            Method = 'Policy'
        }
        @{
            Id = 'user-media'
            Name = 'Media and disc images'
            Category = 'User data'
            Safety = 'Review'
            Priority = 91
            Extensions = @('.iso', '.img', '.mp4', '.mov', '.avi', '.mkv', '.wmv', '.mpg', '.vob', '.wav', '.psd', '.ai', '.raw', '.cr2', '.nef')
            EligibleAfterDays = 365
            Description = 'Large media assets and disc images - often the biggest single files on a workstation.'
            Reason = 'Frequently a duplicate of something on a share or a vendor download, but sometimes an irreplaceable original.'
            Remediation = 'Confirm with the owner, then move to a file share, cloud library or archive tier rather than deleting.'
            Command = ''
            Method = 'Policy'
        }
        @{
            Id = 'user-archives'
            Name = 'Archives'
            Category = 'User data'
            Safety = 'Review'
            Priority = 92
            Extensions = @('.zip', '.7z', '.rar', '.tar', '.gz', '.tgz', '.cab', '.msu', '.iso')
            EligibleAfterDays = 365
            Description = 'Compressed archives, vendor packages and old exports.'
            Reason = 'Usually a copy of data that also exists expanded elsewhere, or a vendor download that can be fetched again.'
            Remediation = 'Spot-check the largest few for anything unique, then archive or delete.'
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'user-installers'
            Name = 'Installers and update packages'
            Category = 'User data'
            Safety = 'Review'
            Priority = 93
            Extensions = @('.msi', '.msp', '.msu', '.appx', '.msix')
            EligibleAfterDays = 180
            Description = 'Downloaded setup packages sitting outside the Windows Installer cache.'
            Reason = 'Re-downloadable from the vendor - as long as the exact version is still published, which matters for legacy line-of-business apps.'
            Remediation = 'Move anything version-locked into the software repository first.'
            Command = ''
            Method = 'Delete'
        }
        @{
            Id = 'user-documents'
            Name = 'User documents and desktop'
            Category = 'User data'
            Safety = 'Unsafe'
            Priority = 94
            PathPattern = '\\Users\\[^\\]+\\(Documents|Desktop|Pictures|Videos|Music|Favorites|Links|Contacts)\\'
            Description = 'Live user data in the profile''s known folders.'
            Reason = 'Owned by the user and often not redirected or backed up. Deleting it is data loss, not cleanup.'
            Remediation = 'Enable Known Folder Move / folder redirection so the data lives in OneDrive or on a share, then free the local copies with Files On-Demand.'
            Command = 'Intune/GPO: "Silently move Windows known folders to OneDrive"'
            Method = 'Policy'
        }
        @{
            Id = 'user-stale-profile'
            Name = 'User profile (possibly stale)'
            Category = 'User profiles'
            Safety = 'Review'
            Priority = 95
            PathPattern = '\\Users\\[^\\]+\\'
            EligibleAfterDays = 180
            Description = 'Profile data for an account that has not written to disk in a long time - often a departed staff member or a one-off login.'
            Reason = 'Reclaimable in bulk, but only after confirming the account is genuinely inactive and nothing unique lives in the profile.'
            Remediation = 'Cross-check last logon in the directory, back up anything unique, then remove the profile through the supported API so the registry entry goes too.'
            Command = 'Get-CimInstance Win32_UserProfile | Where-Object { -not $_.Special -and $_.LastUseTime -lt (Get-Date).AddDays(-180) } | Remove-CimInstance'
            Method = 'Tool'
        }
        @{
            Id = 'user-appdata-roaming'
            Name = 'Roaming application data'
            Category = 'User profiles'
            Safety = 'Unsafe'
            Priority = 96
            PathPattern = '\\Users\\[^\\]+\\AppData\\Roaming\\'
            Description = 'Per-user application settings, signatures, templates and licence state.'
            Reason = 'Small but load-bearing. Deleting it resets applications and can invalidate licences or saved credentials.'
            Remediation = 'Leave it. If it is genuinely large, find the specific application writing into it and fix that.'
            Command = ''
            Method = 'Policy'
        }
        #endregion

        #region Program and system files --------------------------------------------------------
        @{
            Id = 'sys-programfiles'
            Name = 'Installed application files'
            Category = 'Installed software'
            Safety = 'Unsafe'
            Priority = 97
            PathPattern = '^[A-Za-z]:\\Program Files( \(x86\))?\\'
            Description = 'Binaries and resources belonging to installed software.'
            Reason = 'Deleting files here breaks the application and leaves it half-registered, which then blocks reinstall.'
            Remediation = 'Uninstall the products that are no longer needed, largest first.'
            Command = 'Get-Package | Sort-Object Name   # then uninstall through Programs and Features / your RMM'
            Method = 'Policy'
        }
        @{
            Id = 'sys-windows-other'
            Name = 'Operating system files'
            Category = 'Operating system'
            Safety = 'Unsafe'
            Priority = 98
            PathPattern = '^[A-Za-z]:\\Windows\\'
            Description = 'Core Windows binaries and configuration outside the caches already accounted for.'
            Reason = 'Required for the machine to boot and stay serviceable.'
            Remediation = 'Use the built-in cleanup paths (Disk Cleanup / StartComponentCleanup) rather than touching files directly.'
            Command = 'cleanmgr /d C: /sageset:1'
            Method = 'Tool'
        }
        @{
            Id = 'unclassified'
            Name = 'Unclassified data'
            Category = 'Unclassified'
            Safety = 'Review'
            Priority = 999
            Description = 'No rule matched, so this is most likely application or business data specific to this machine.'
            Reason = 'Unknown ownership. Treat as live data until someone identifies it.'
            Remediation = 'Look at the owning folder in the directory breakdown to work out which application or team owns it, then decide.'
            Command = ''
            Method = 'Policy'
        }
        #endregion
    )
}
